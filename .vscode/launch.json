{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Ejecutar archivo actual",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "API (FastAPI con recarga)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["demo_agent.api:app", "--reload"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
